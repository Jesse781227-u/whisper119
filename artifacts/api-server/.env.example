# Google Cloud Storage / Firebase Storage
GCS_BUCKET_NAME=your-project.firebasestorage.app
GCS_PROJECT_ID=your-firebase-project-id

# Use either Application Default Credentials or these service-account values.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCS_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Optional object layout settings
GCS_UPLOAD_PREFIX=uploads
GCS_PUBLIC_PREFIXES=public
