# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=whisper
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your-public-bucket-id.r2.dev

# Optional object layout settings
R2_UPLOAD_PREFIX=uploads
R2_PUBLIC_PREFIXES=public

# Payments (server-side only). Flutterwave accepts a currency per checkout,
# so the storefront can create separate NGN and USD transactions.
# The app URL is used as Flutterwave's post-payment redirect target.
PUBLIC_APP_URL=https://whisper119.com
FLW_SECRET_KEY=your_flutterwave_secret_key
FLW_PUBLIC_KEY=your_flutterwave_public_key
FLW_ENCRYPTION_KEY=your_flutterwave_encryption_key
# Set this to the secret hash configured in Flutterwave webhook settings.
# Webhook endpoint: https://whisper119.com/api/payments/flutterwave/webhook
FLW_SECRET_HASH=your_flutterwave_webhook_secret_hash

# Render Free blocks SMTP ports 25, 465, and 587. Use a provider's
# submission port 2525 with STARTTLS, or deploy the API on a paid Render tier.
SMTP_HOST=smtp.example.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM_ADDRESS=Whisper 119 <delivery@whisper119.com>

# HTTPS email delivery for Render Free (recommended; no SMTP port required).
# Create a Resend API key and verify the sender domain used in MAIL_FROM_ADDRESS.
RESEND_API_KEY=re_your_api_key
