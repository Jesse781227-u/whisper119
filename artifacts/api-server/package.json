{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "backfill:purchase-subscribers": "tsx ./src/scripts/backfill-purchase-subscribers.ts",
    "start": "node --env-file=.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx ./src/scripts/migrate.ts",
    "cf:dev": "pnpm --filter @workspace/whisper119 run build && wrangler dev",
    "deploy": "pnpm --filter @workspace/whisper119 run build && wrangler deploy",
    "deploy:dry-run": "pnpm --filter @workspace/whisper119 run build && wrangler deploy --dry-run --outdir dist-worker",
    "tags:report": "tsx ./src/scripts/list-overtagged-books.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@google-cloud/storage": "^7.21.0",
    "@types/nodemailer": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "html-to-text": "^10.0.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.14.0",
    "resend": "^6.0.0",
    "svix": "^2.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "wrangler": "^4.160.0"
  }
}
